# Smartcar API credentials
SMARTCAR_MANAGEMENT_TOKEN=<your-management-token>
SMARTCAR_WEBHOOK_SECRET=<your-secret-from-smartcar-dashboard>

# Webhook server configuration
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=5000
WEBHOOK_DEBUG=false

# traccar server configuration
TRACCAR_API_URL=http://your-traccar-server:8082
TRACCAR_USERNAME=your-username
TRACCAR_PASSWORD=your-password
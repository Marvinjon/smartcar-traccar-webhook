# Smartcar API credentials
SMARTCAR_MANAGEMENT_TOKEN=<your-management-token>

# Additional webhook integrations (optional)
# Add more tokens for named integrations, accessible at /webhooks/smartcar/<name>
# Example: /webhooks/smartcar/fleet2 uses SMARTCAR_MANAGEMENT_TOKEN_FLEET2
# SMARTCAR_MANAGEMENT_TOKEN_FLEET2=<your-second-management-token>

# Webhook server configuration
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=5000
WEBHOOK_DEBUG=false

# traccar server configuration
TRACCAR_API_URL=https://example.com # the url of the traccar api, can be the same as TRACCAR_BASE_URL if the devices report to the same url as the API
TRACCAR_BASE_URL=https://example.example.com:5055 # the url that the devices report to, can be the same as TRACCAR_API_URL if the devices report to the same url as the API
TRACCAR_USERNAME=your-username
TRACCAR_PASSWORD=your-password